# Application
APP_NAME=CapEvents AI Service
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8001

# Security
AI_SERVICE_KEY=change-me-secret-key

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/capevents

# Ollama / LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b

# Recommendation
RECOMMENDATION_MODEL_TASK=recommendation

# Planning LLM
PLANNING_LLM_ENABLED=true
PLANNING_LLM_PROVIDER=ollama
PLANNING_LLM_BASE_URL=http://127.0.0.1:11434
PLANNING_LLM_MODEL=qwen2.5:3b
PLANNING_LLM_TIMEOUT_SECONDS=180